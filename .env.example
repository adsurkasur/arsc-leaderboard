# Public Supabase connection used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key injected automatically by a connected Supabase/Vercel project.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Optional legacy/local alias when the Vercel integration is not used.
SUPABASE_INTEGRATION_SERVICE_KEY=
RAPOR_ACCESS_CODE_PEPPER=use-the-same-secret-as-rapor-arsc
