# Public Supabase connection used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only integration values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_INTEGRATION_SERVICE_KEY=your-service-role-key
RAPOR_ACCESS_CODE_PEPPER=use-the-same-secret-as-rapor-arsc
