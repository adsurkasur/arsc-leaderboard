{
  "version": 1,
  "producer": "Rapor-ARSC-2025-2026",
  "consumer": "arsc-leaderboard",
  "referenceRpc": {
    "schema": "public",
    "name": "get_leaderboard_reference_members",
    "columns": [
      "release_member_code",
      "release_code",
      "canonical_name",
      "unit",
      "position"
    ],
    "eligibility": {
      "releaseStatus": "published",
      "releaseActive": true
    },
