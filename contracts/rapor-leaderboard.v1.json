    "normalization": "trim-lowercase",
    "inputFormat": "normalized_code::pepper",
    "pepperEnvironmentVariable": "RAPOR_ACCESS_CODE_PEPPER"
  },
  "privacy": {
    "publicRaporTableAccess": false,
    "accessCodeStoredByConsumer": false
  }
}
